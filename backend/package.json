{
  "name": "@flaights/backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "npm run generate:all && npm run sync:frontend && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && esbuild dist/**/*.js --minify --outdir=dist --allow-overwrite",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "openapi:spec": "tsoa spec && npx tsx scripts/post-process-openapi.ts",
    "asyncapi:spec": "npx tsx scripts/generate-asyncapi.ts",
    "asyncapi:docs": "npx asyncapi generate fromTemplate build/asyncapi.json @asyncapi/html-template -o build/asyncapi-docs --force-write",
    "sync:frontend": "shx cp build/openapi.json ../frontend/src/api/openapi.json && shx cp build/asyncapi.json ../frontend/src/api/asyncapi.json",
    "openapi:routes": "tsoa routes",
    "asyncapi:routes": "npx tsx scripts/generate-async-routes.ts",
    "generate:all": "concurrently \"npm run openapi:spec\" \"npm run asyncapi:spec\" \"npm run asyncapi:routes\" \"npm run openapi:routes\""
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@asyncapi/cli": "^6.0.0",
    "@asyncapi/generator": "^3.2.0",
    "@asyncapi/html-template": "^3.5.6",
    "@asyncapi/parser": "^3.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bytes": "^3.1.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^7.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.7",
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "ts-morph": "^27.0.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-json-schema": "^0.67.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1025.0",
    "@aws-sdk/s3-request-presigner": "^3.1025.0",
    "@types/express-rate-limit": "^5.1.3",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "bytes": "^3.1.2",
    "compression": "^1.8.1",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-ws": "^5.0.2",
    "file-type": "^21.3.4",
    "fuzzysort": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "mime": "^4.1.0",
    "mongoose": "^9.4.1",
    "nodemailer": "^8.0.4",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "tsyringe": "^4.10.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "jsonpath-plus": "10.4.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "minimatch": "^3.1.2",
    "ajv": "^6.12.6",
    "tar": "^7.5.13",
    "@tootallnate/once": "3.0.1",
    "next": "^15.5.14",
    "rollup": "^2.80.0",
    "brace-expansion": "^2.0.3",
    "picomatch": "^4.0.4"
  }
}